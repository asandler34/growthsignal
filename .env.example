# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:5432/growthsignal
# DATABASE_SSL=true            # set for managed Postgres that requires TLS
ROLE=all                        # web | worker | all
SESSION_SECRET=change-me-to-64-random-characters
TRUST_PROXY=false
CRON_SECRET=                    # required on Vercel; bearer token for /api/cron/* and /api/ops/selftest
# NODEJS_HELPERS=0              # set on Vercel so the Stripe webhook receives the raw body
OPERATOR_EMAIL=                 # where inquiry notifications go

# Email: resend | postmark | console (console is development only)
EMAIL_PROVIDER=console
EMAIL_FROM=GrowthSignal <hello@growthsignal.ai>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# Stripe (use sk_test_ keys until launch is authorized; live keys are refused unless STRIPE_ALLOW_LIVE=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CHECK_MONTHLY=
STRIPE_PRICE_CHECK_ANNUAL=
STRIPE_PRICE_IMPROVE_MONTHLY=
STRIPE_PRICE_IMPROVE_ANNUAL=
STRIPE_PRICE_GROW_MONTHLY=
STRIPE_PRICE_GROW_ANNUAL=
STRIPE_ALLOW_LIVE=false

# AI platforms (any subset; unconnected platforms are shown as "not connected")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=perplexity/sonar
# Gemini stays off unless GEMINI_ENABLED=true; needs legal review of Google's grounding terms first (docs/decision-log.md D-023).
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=               # Console API key, starts with sk-ant-api
ANTHROPIC_MODEL=claude-haiku-4-5
AI_DAILY_BUDGET_CENTS=2000      # hard daily cap on AI spend across all customers

# Limits
ANON_SCANS_PER_IP_PER_HOUR=5
ANON_SCANS_PER_DAY=500
ANON_SNAPSHOTS_PER_DAY=300       # free AI answers on anonymous previews, all visitors per day
LOGIN_EMAILS_PER_HOUR=5
WORKER_CONCURRENCY=3

# Development only: allow scanning 127.0.0.1 fixtures. Ignored in production.
# SCANNER_ALLOW_PRIVATE=loopback
